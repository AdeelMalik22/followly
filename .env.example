# Host-based local staging environment. Copy to .env and replace secrets.
DATABASE_URL=postgresql://followly:replace-me@localhost:5432/followly
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=replace-with-a-long-random-secret
JWT_PREVIOUS_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CUSTOMER_TOKEN_EXPIRE_MINUTES=43200
COOKIE_SECURE=false

# Application URLs and CORS
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Karachi

# LLM: configure one provider for test-chat and agent flows.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe test-mode credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me

# WhatsApp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v17.0

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
CUSTOMER_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/customer/auth/callback
